<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UfoDetector.Controls"
             xmlns:converters="clr-namespace:UfoDetector.Converters"
             xmlns:vm="clr-namespace:UfoDetector.ViewModels"
             x:Class="UfoDetector.Views.DetectorPage"
             x:DataType="vm:DetectorViewModel"
             BackgroundColor="{StaticResource CrtBackground}"
             Title="">

    <ContentPage.Resources>
        <converters:SensorStatusToColorConverter x:Key="StatusColorConverter" />
        <converters:SensorStatusToTextConverter  x:Key="StatusTextConverter"  />

        <!-- Sensor name label -->
        <Style x:Key="GaugeName" TargetType="Label">
            <Setter Property="FontFamily"   Value="ShareTechMono" />
            <Setter Property="FontSize"     Value="20" />
            <Setter Property="TextColor"    Value="#2A6640" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin"       Value="8" />
        </Style>

        <!-- Numeric value label -->
        <Style x:Key="GaugeValue" TargetType="Label">
            <Setter Property="FontFamily"   Value="ShareTechMono" />
            <Setter Property="FontSize"     Value="20" />
            <Setter Property="TextColor"    Value="{StaticResource PhosphorGreen}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin"       Value="8" />
        </Style>

        <!-- Unit label -->
        <Style x:Key="GaugeUnit" TargetType="Label">
            <Setter Property="FontFamily"   Value="ShareTechMono" />
            <Setter Property="FontSize"     Value="20" />
            <Setter Property="TextColor"    Value="#7DFF9A" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin"       Value="8" />
        </Style>

        <!-- Status label (НОРМА / ПОВЫШЕН / …) -->
        <Style x:Key="GaugeStatus" TargetType="Label">
            <Setter Property="FontFamily"   Value="ShareTechMono" />
            <Setter Property="FontSize"     Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor"    Value="{StaticResource PhosphorGreen}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin"       Value="8" />
        </Style>

        <!-- Fill bar -->
        <Style x:Key="GaugeBar" TargetType="ProgressBar">
            <Setter Property="ProgressColor" Value="{StaticResource PhosphorGreen}" />
            <Setter Property="HeightRequest" Value="4" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="FontFamily"     Value="ShareTechMono" />
            <Setter Property="FontSize"       Value="20" />
            <Setter Property="TextColor"      Value="#2A6640" />
            <Setter Property="Margin"         Value="8" />
        </Style>
    </ContentPage.Resources>

    <!-- Root: background image behind header + body -->
    <Grid>

        <Image Source="background.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ── B + C: Radar left, Controls right ─────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">

            <!-- Left column: Radar + 4 sensors -->
            <Grid RowDefinitions="Auto, *">

                <!-- Radar -->
                <Grid Grid.Row="0" RowDefinitions="Auto, *, Auto">
                    <!-- AbsoluteLayout gives pixel-style X/Y placement; LayoutBounds = x, y, width, height in DIPs -->
                    <AbsoluteLayout Grid.Row="1">
                        <controls:RadarCanvasView
                            AbsoluteLayout.LayoutFlags="None"
                            AbsoluteLayout.LayoutBounds="95, 165, 475, 475"
                            ActiveAnomaly="{Binding ActiveAnomaly}"
                            Phase="{Binding Phase}" />
                    </AbsoluteLayout>
                </Grid>

                <!-- C: sensor gauges — single row of 4 vertical meters -->
                <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *">

                    <!-- C1: Neutron gauge -->
                    <AbsoluteLayout Grid.Column="0">
                        <Label Text="{Binding NeutronValue, StringFormat='{0:F1}'}" Style="{StaticResource GaugeValue}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="50, 0, 100, 30" />
                        <Label Text="{Binding NeutronUnit}" Style="{StaticResource GaugeUnit}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="50, 35, 100, 30" />
                    </AbsoluteLayout>

                    <!-- C2: Ionisation gauge -->
                    <AbsoluteLayout Grid.Column="1">
                        <Label Text="{Binding IonisationValue, StringFormat='{0:F0}'}" Style="{StaticResource GaugeValue}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 40, 100, 30" />
                        <Label Text="{Binding IonisationUnit}" Style="{StaticResource GaugeUnit}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 75, 100, 30" />
                    </AbsoluteLayout>

                    <!-- C3: Geomagnetic gauge -->
                    <AbsoluteLayout Grid.Column="2">
                        <Label Text="{Binding GeomagneticValue, StringFormat='{0:F0}'}" Style="{StaticResource GaugeValue}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 40, 100, 30" />
                        <Label Text="{Binding GeomagneticUnit}" Style="{StaticResource GaugeUnit}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 75, 100, 30" />
                    </AbsoluteLayout>

                    <!-- C4: Thermal gauge -->
                    <AbsoluteLayout Grid.Column="3">
                        <Label Text="{Binding ThermalValue, StringFormat='{0:F2}'}" Style="{StaticResource GaugeValue}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 40, 100, 30" />
                        <Label Text="{Binding ThermalUnit}" Style="{StaticResource GaugeUnit}"
                               AbsoluteLayout.LayoutFlags="None" AbsoluteLayout.LayoutBounds="0, 75, 100, 30" />
                    </AbsoluteLayout>

                </Grid>

            </Grid>

            <!-- Right column: Controls panel -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">

                <!-- Mode toggle: LED + Button (T039) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="2" Margin="2,2,2,6">
                    <!-- LED indicator: green=АКТИВ, amber=ПАССИВ -->
                    <BoxView Grid.Column="0"
                             WidthRequest="10" HeightRequest="10" CornerRadius="0"
                             VerticalOptions="Center" Margin="0,0,8,0"
                             Color="{StaticResource StatusAmber}">
                        <BoxView.Style>
                            <Style TargetType="BoxView">
                                <Setter Property="Color" Value="{StaticResource StatusAmber}"/>
                                <Style.Triggers>
                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding IsActiveMode}" Value="True">
                                        <Setter Property="Color" Value="{StaticResource PhosphorGreen}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </BoxView.Style>
                    </BoxView>
                    <Button Grid.Column="1"
                            Text="{Binding ModeLabel}"
                            Command="{Binding ToggleModeCommand}"
                            FontFamily="ShareTechMono" FontSize="20"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource PhosphorGreenDim}"
                            BorderWidth="1"
                            TextColor="{StaticResource PhosphorGreen}"
                            Padding="4,4" />
                </Grid>

                <!-- Vertical sliders (T038): AbsoluteLayout gives manual X/Y placement; container Margin/size and each
                     slider's LayoutBounds (x, y, width, height in DIPs) can all be adjusted independently.
                     Keep both sliders' height equal and vary their x to change the spacing between them. -->
                <AbsoluteLayout Grid.Row="1"
                                HorizontalOptions="Start" VerticalOptions="Start"
                                Margin="-5, 320, 0, 0"
                                WidthRequest="200" HeightRequest="160">

                    <!-- Sensitivity slider -->
                    <controls:VerticalBarSliderView
                            AbsoluteLayout.LayoutFlags="None"
                            AbsoluteLayout.LayoutBounds="0, 0, 40, 342"
                            Minimum="0" Maximum="100" BarWidth="16"
                            Value="{Binding Sensitivity, Mode=TwoWay}" />

                    <!-- Noise suppression slider -->
                    <controls:VerticalBarSliderView
                            AbsoluteLayout.LayoutFlags="None"
                            AbsoluteLayout.LayoutBounds="120, 0, 40, 342"
                            Minimum="0" Maximum="100" BarWidth="16"
                            Value="{Binding NoiseSuppression, Mode=TwoWay}" />

                </AbsoluteLayout>

            </Grid>

        </Grid>

        <!-- ── D: Chrono anomaly row ──────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto">
            
            <Label Grid.Column="1"
                   Text="{Binding ChronoValue, StringFormat='Δt {0:F4}с'}"
                   Style="{StaticResource GaugeValue}" FontSize="20"
                   VerticalOptions="Center" />            
        </Grid>

        <!-- ── F: Infrasound spectrum ─────────────────────────────────────── -->
        <StackLayout Grid.Row="2" Spacing="4">
            <Label Text="ИНФРАЗВУК  0 — 20 Гц" Style="{StaticResource SectionHeader}" />
            <controls:InfrasoundCanvasView
                Bands="{Binding InfrasoundBands}"
                HeightRequest="120"
                HorizontalOptions="Fill" />
        </StackLayout>

    </Grid>
    </Grid>
</ContentPage>
